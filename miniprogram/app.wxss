page {
  min-height: 100vh;
  color: #3d2f2f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: #fff8f0;
  box-sizing: border-box;
}

view,
text,
button,
navigator {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2f2525;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8b6b63;
}

.card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.12);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 107, 0.22);
}

.secondary-link {
  display: inline-flex;
  margin-top: 24rpx;
  color: #ff6b6b;
  font-size: 26rpx;
}
