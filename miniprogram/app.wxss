page {
  min-height: 100vh;
  color: #3b2431;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  background: linear-gradient(180deg, #fff6fb 0%, #fff1c8 58%, #fffaf1 100%);
  box-sizing: border-box;
}

view,
text,
button,
navigator {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 34rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

button {
  padding: 0;
  text-align: center;
}

button::after {
  border: 0;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #311d2b;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8f5d73;
}

.card {
  margin-top: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.14);
}

.card:active,
.primary-button:active,
.secondary-link:active {
  opacity: 0.9;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff5fa2 0%, #ff8ac0 54%, #ffd84d 130%);
  box-shadow: 0 14rpx 30rpx rgba(255, 95, 162, 0.28);
}

.secondary-link {
  display: inline-flex;
  margin-top: 24rpx;
  color: #ff4f99;
  font-size: 26rpx;
  font-weight: 700;
}
