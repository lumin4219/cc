<view class="page">
  <view class="step-card">
    <view>
      <view class="step-label">第 2 步 / 共 3 步</view>
      <view class="page-title">选择收礼人</view>
      <view class="page-subtitle">{{eventName}} · {{eventDate}}</view>
    </view>
  </view>

  <view class="selected-card">
    <view class="selected-info">
      <view class="selected-label">已选场景</view>
      <view class="selected-value">{{selectedScene || '待选择'}}</view>
    </view>
    <button class="change-button" bindtap="goBackToScene">返回修改</button>
  </view>

  <view class="group-card" wx:if="{{commonContacts.length}}">
    <view class="group-title">
      <text class="group-icon">⭐</text>
      <text>常用联系人</text>
    </view>
    <view class="contact-list">
      <view
        class="contact-pill"
        wx:for="{{commonContacts}}"
        wx:key="id"
        data-recipient="{{item.recipient}}"
        data-name="{{item.name}}"
        bindtap="handleRecipientTap"
      >
        {{item.name}} · {{item.recipient}}
      </view>
    </view>
  </view>

  <view class="group-list">
    <view class="group-card" wx:for="{{recipientGroups}}" wx:key="title">
      <view class="group-title">
        <text class="group-icon">{{item.icon}}</text>
        <text>{{item.title}}</text>
      </view>

      <view class="recipient-grid">
        <view
          class="recipient-option"
          wx:for="{{item.people}}"
          wx:for-item="person"
          wx:key="*this"
          data-recipient="{{person}}"
          bindtap="handleRecipientTap"
        >
          <text class="recipient-icon">{{item.icon}}</text>
          <text class="recipient-name">{{person}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
