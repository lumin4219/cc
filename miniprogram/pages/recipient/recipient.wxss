.step-card {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.44);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff6fb 0%, #ffffff 54%, #fff2a8 150%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.14);
}

.step-card::after {
  position: absolute;
  right: -52rpx;
  top: -52rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(255, 216, 77, 0.35);
  content: "";
}

.step-label {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffe37a;
}

.selected-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.38);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(255, 95, 162, 0.1);
}

.selected-info {
  min-width: 0;
}

.selected-label {
  color: #a05b76;
  font-size: 24rpx;
}

.selected-value {
  margin-top: 8rpx;
  color: #321d2c;
  font-size: 32rpx;
  font-weight: 700;
}

.change-button {
  flex-shrink: 0;
  min-width: 152rpx;
  margin: 0 0 0 20rpx;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ff4f99;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 700;
  background: #fff0b8;
}

.change-button::after {
  border: 0;
}

.group-list {
  margin-top: 30rpx;
}

.group-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.34);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(255, 95, 162, 0.11);
}

.group-card:first-child {
  margin-top: 0;
}

.group-title {
  display: flex;
  align-items: center;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 900;
}

.group-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.recipient-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.recipient-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 31.5%;
  min-height: 128rpx;
  margin-top: 18rpx;
  padding: 18rpx 10rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaff, #fff8df);
  box-shadow: 0 10rpx 22rpx rgba(255, 95, 162, 0.08);
}

.recipient-option:nth-child(-n + 3) {
  margin-top: 0;
}

.recipient-option:active {
  transform: scale(0.97);
  border-color: #ff8ac0;
  background: #fff0f8;
}

.recipient-icon {
  font-size: 38rpx;
  line-height: 1;
}

.recipient-name {
  margin-top: 14rpx;
  color: #432236;
  font-size: 26rpx;
  font-weight: 800;
}
