.step-card {
  padding: 34rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff1ea, #ffffff);
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.step-label {
  margin-bottom: 12rpx;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx 22rpx;
  border: 2rpx solid rgba(255, 107, 107, 0.16);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.08);
}

.selected-item {
  flex: 1;
  min-width: 0;
}

.selected-label {
  color: #b68a7e;
  font-size: 23rpx;
}

.selected-value {
  margin-top: 8rpx;
  color: #3d2f2f;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.divider {
  width: 1rpx;
  height: 56rpx;
  margin: 0 18rpx;
  background: #f3ded3;
}

.change-button {
  flex-shrink: 0;
  min-width: 132rpx;
  margin: 0 0 0 18rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ff6b6b;
  font-size: 23rpx;
  line-height: 56rpx;
  background: #fff1ea;
}

.change-button::after {
  border: 0;
}

.budget-list {
  margin-top: 30rpx;
}

.budget-card {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  margin-top: 22rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.budget-card:first-child {
  margin-top: 0;
}

.budget-card:active {
  transform: scale(0.98);
  background: #fffaf6;
}

.budget-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  font-size: 42rpx;
  background: #fff1ea;
}

.budget-content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.budget-title {
  color: #3d2f2f;
  font-size: 31rpx;
  font-weight: 700;
}

.budget-desc {
  margin-top: 8rpx;
  color: #8b6b63;
  font-size: 26rpx;
}

.budget-examples {
  margin-top: 8rpx;
  color: #c29688;
  font-size: 23rpx;
}

.budget-arrow {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #ff8e8e;
  font-size: 48rpx;
  line-height: 1;
}
