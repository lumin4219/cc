.step-card {
  position: relative;
  overflow: hidden;
  padding: 38rpx 34rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.44);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff6fb 0%, #ffffff 54%, #fff2a8 150%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.14);
}

.step-card::after {
  position: absolute;
  right: -52rpx;
  top: -52rpx;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(255, 216, 77, 0.35);
  content: "";
}

.step-label {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffe37a;
}

.selected-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.38);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(255, 95, 162, 0.1);
}

.selected-item {
  flex: 1;
  min-width: 0;
}

.selected-label {
  color: #a05b76;
  font-size: 23rpx;
}

.selected-value {
  margin-top: 8rpx;
  color: #321d2c;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.divider {
  width: 1rpx;
  height: 56rpx;
  margin: 0 18rpx;
  background: rgba(255, 216, 77, 0.44);
}

.change-button {
  flex-shrink: 0;
  min-width: 132rpx;
  margin: 0 0 0 18rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  color: #ff4f99;
  font-size: 23rpx;
  line-height: 56rpx;
  font-weight: 700;
  background: #fff0b8;
}

.change-button::after {
  border: 0;
}

.budget-list {
  margin-top: 30rpx;
}

.budget-card {
  display: flex;
  align-items: center;
  min-height: 148rpx;
  margin-top: 22rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.34);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 38rpx rgba(255, 95, 162, 0.11);
}

.budget-card:first-child {
  margin-top: 0;
}

.budget-card:active {
  transform: scale(0.98);
  background: #fff7dc;
}

.budget-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  font-size: 42rpx;
  background: linear-gradient(135deg, #fff2a8, #ffe37a);
  box-shadow: 0 8rpx 18rpx rgba(255, 216, 77, 0.32);
}

.budget-content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.budget-title {
  color: #321d2c;
  font-size: 31rpx;
  font-weight: 900;
}

.budget-desc {
  margin-top: 8rpx;
  color: #8f5d73;
  font-size: 26rpx;
}

.budget-examples {
  margin-top: 8rpx;
  color: #b26985;
  font-size: 23rpx;
}

.budget-arrow {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #ff5fa2;
  font-size: 48rpx;
  line-height: 1;
}
