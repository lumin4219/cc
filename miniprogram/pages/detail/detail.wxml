<view class="page">
  <view class="detail-hero">
    <view class="detail-badge">{{type === 'flower' ? '花束详情' : '礼物详情'}}</view>
    <view class="page-title">{{title}}</view>
    <view class="page-subtitle">送给 {{name || recipient}} · {{scene}}</view>
  </view>

  <view class="detail-card" wx:if="{{item}}">
    <view class="section-title">{{type === 'flower' ? '花语' : '推荐理由'}}</view>
    <view class="detail-text">{{type === 'flower' ? item.language : item.reason}}</view>

    <view class="section-title">适用场景</view>
    <view class="chip-row">
      <view class="chip" wx:if="{{type === 'flower'}}">{{scene}}</view>
      <view class="chip" wx:else wx:for="{{item.scenes}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="section-title">适合送谁</view>
    <view class="chip-row">
      <view class="chip" wx:if="{{type === 'flower'}}" wx:for="{{item.suitable_recipients}}" wx:key="*this">{{item}}</view>
      <view class="chip" wx:else wx:for="{{item.recipients}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="section-title">搭配推荐</view>
    <view class="detail-text">{{type === 'flower' ? item.tips : item.tips}}</view>

    <view class="section-title">注意事项</view>
    <view class="detail-text">{{item.taboo}}</view>
  </view>

  <view class="detail-card" wx:else>
    <view class="section-title">没有找到详情</view>
    <view class="detail-text">请返回重新选择推荐项。</view>
  </view>

  <button class="buy-button" bindtap="copyKeyword">去购买（复制关键词）</button>
  <view class="safe-note">个人主体工具类暂不直接跳转电商。你可以复制关键词到常用平台自行搜索。</view>
</view>
