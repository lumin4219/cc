<view class="page">
  <view class="detail-hero">
    <view class="detail-badge">{{detailTypeLabel}}</view>
    <view class="page-title">{{title}}</view>
    <view class="page-subtitle">送给 {{displayName}} · {{scene}}</view>
  </view>

  <view class="detail-card" wx:if="{{item}}">
    <view class="section-title">{{primaryTitle}}</view>
    <view class="detail-text">{{primaryText}}</view>

    <view class="section-title">适用场景</view>
    <view class="chip-row">
      <view class="chip" wx:for="{{sceneChips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="section-title">适合送谁</view>
    <view class="chip-row">
      <view class="chip" wx:for="{{recipientChips}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="section-title">搭配推荐</view>
    <view class="detail-text">{{pairingText}}</view>

    <view class="section-title">注意事项</view>
    <view class="detail-text">{{cautionText}}</view>
  </view>

  <view class="detail-card" wx:else>
    <view class="section-title">没有找到详情</view>
    <view class="detail-text">请返回重新选择推荐项。</view>
  </view>

  <button class="buy-button" bindtap="copyKeyword">去购买（复制关键词）</button>
  <view class="safe-note">个人主体工具类暂不直接跳转电商。你可以复制关键词到常用平台自行搜索。</view>
</view>
