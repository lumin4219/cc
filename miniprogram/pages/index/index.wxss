.hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 42rpx 34rpx 38rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2 0%, #ff85bd 56%, #ffd84d 140%);
  box-shadow: 0 24rpx 52rpx rgba(255, 95, 162, 0.3);
}

.hero::before {
  position: absolute;
  right: -70rpx;
  bottom: -80rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 216, 77, 0.3);
  content: "";
}

.hero::after {
  position: absolute;
  right: 72rpx;
  top: 58rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  content: "";
}

.hero-glow {
  position: absolute;
  left: -42rpx;
  top: -48rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero > view,
.hero navigator {
  position: relative;
  z-index: 1;
}

.hero .hero-glow {
  position: absolute;
  z-index: 0;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffe37a;
}

.app-name {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 14rpx rgba(151, 36, 95, 0.22);
}

.app-slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.96);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.hero-tags text {
  margin-right: 14rpx;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
}

.about-entry {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.14);
}

.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 36rpx;
}

.section-title {
  color: #321d2c;
  font-size: 34rpx;
  font-weight: 900;
}

.section-tip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 700;
  background: #ffe37a;
}

.scene-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.scene-card {
  width: 48.4%;
  min-height: 196rpx;
  margin-top: 22rpx;
  padding: 26rpx 22rpx 24rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.34);
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 246, 251, 0.94));
  box-shadow: 0 16rpx 36rpx rgba(255, 95, 162, 0.12);
}

.scene-card:nth-child(-n + 2) {
  margin-top: 0;
}

.scene-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.scene-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  font-size: 42rpx;
  line-height: 1;
  background: linear-gradient(135deg, #fff2a8, #ffe37a);
}

.scene-name {
  margin-top: 18rpx;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 900;
}

.scene-desc {
  margin-top: 8rpx;
  color: #9a5c75;
  font-size: 26rpx;
}

.festival-card {
  margin-top: 34rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.55);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fffbe6, #ffffff 72%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.12);
}

.festival-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 900;
}

.festival-list {
  margin-top: 20rpx;
}

.festival-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 216, 77, 0.34);
}

.festival-item:first-child {
  border-top: 0;
}

.festival-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.festival-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.festival-name {
  color: #432236;
  font-size: 28rpx;
  font-weight: 600;
}

.festival-days {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 700;
  background: #ffe37a;
}
