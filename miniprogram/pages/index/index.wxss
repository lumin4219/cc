.hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 42rpx 34rpx 38rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2 0%, #ff85bd 56%, #ffd84d 140%);
  box-shadow: 0 24rpx 52rpx rgba(255, 95, 162, 0.3);
}

.hero::before {
  position: absolute;
  right: -70rpx;
  bottom: -80rpx;
  width: 250rpx;
  height: 250rpx;
  border-radius: 50%;
  background: rgba(255, 216, 77, 0.3);
  content: "";
}

.hero::after {
  position: absolute;
  right: 72rpx;
  top: 58rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  content: "";
}

.hero-glow {
  position: absolute;
  left: -42rpx;
  top: -48rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero > view,
.hero navigator {
  position: relative;
  z-index: 1;
}

.hero .hero-glow {
  position: absolute;
  z-index: 0;
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffe37a;
}

.app-name {
  margin-top: 18rpx;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 14rpx rgba(151, 36, 95, 0.22);
}

.app-slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.96);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.hero-tags text {
  margin-right: 14rpx;
  margin-top: 10rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
}

.about-entry {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.14);
}

.calendar-card,
.add-card,
.scene-picker-card {
  margin-top: 30rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.13);
}

.calendar-header,
.add-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-button {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 50%;
  color: #ff4f99;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: #fff0b8;
}

.calendar-title,
.add-title {
  color: #321d2c;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.calendar-subtitle,
.add-desc {
  margin-top: 8rpx;
  color: #9a5c75;
  font-size: 24rpx;
  text-align: center;
}

.week-row,
.month-grid {
  display: flex;
  flex-wrap: wrap;
}

.week-row {
  margin-top: 28rpx;
}

.week-cell,
.day-cell {
  width: 14.28%;
  text-align: center;
}

.week-cell {
  color: #a05b76;
  font-size: 23rpx;
  font-weight: 700;
}

.month-grid {
  margin-top: 12rpx;
}

.day-cell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  height: 82rpx;
  color: #432236;
  font-size: 27rpx;
  font-weight: 800;
  border-radius: 24rpx;
}

.day-cell.empty {
  opacity: 0;
}

.day-cell.today {
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
  box-shadow: 0 8rpx 18rpx rgba(255, 95, 162, 0.22);
}

.day-cell:active {
  transform: scale(0.98);
}

.dot-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 12rpx;
  margin-top: 6rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 0 3rpx;
  border-radius: 50%;
}

.dot.red {
  background: #ff4f72;
}

.dot.purple {
  background: #9b5cff;
}

.add-title,
.add-desc {
  text-align: left;
}

.add-button,
.save-button {
  margin: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-weight: 800;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
}

.add-button {
  width: 132rpx;
  height: 64rpx;
  font-size: 25rpx;
  line-height: 64rpx;
}

.add-form {
  margin-top: 24rpx;
}

.form-input,
.date-picker {
  min-height: 82rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 24rpx;
  color: #432236;
  font-size: 26rpx;
  line-height: 82rpx;
  background: #fff8df;
}

.save-button {
  height: 82rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 82rpx;
}

.scene-picker-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 248, 223, 0.96));
}

.scene-picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.scene-picker-title {
  color: #321d2c;
  font-size: 32rpx;
  font-weight: 900;
}

.scene-picker-desc {
  margin-top: 8rpx;
  color: #9a5c75;
  font-size: 24rpx;
}

.scene-close-button {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  border-radius: 50%;
  color: #ff4f99;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 56rpx;
  background: #fff0b8;
}

.scene-option-list {
  margin-top: 22rpx;
}

.scene-option {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.36);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(255, 95, 162, 0.08);
}

.scene-option:first-child {
  margin-top: 0;
}

.scene-option:active {
  transform: scale(0.98);
}

.scene-option-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  font-size: 40rpx;
  background: linear-gradient(135deg, #fff2a8, #ffe37a);
}

.scene-option-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.scene-option-name {
  color: #321d2c;
  font-size: 28rpx;
  font-weight: 900;
}

.scene-option-label {
  margin-top: 8rpx;
  color: #9a5c75;
  font-size: 23rpx;
}

.scene-option-arrow {
  flex-shrink: 0;
  color: #ff4f99;
  font-size: 46rpx;
  font-weight: 700;
}

.festival-card {
  margin-top: 34rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.55);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fffbe6, #ffffff 72%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.12);
}

.festival-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 900;
}

.festival-list {
  margin-top: 20rpx;
}

.festival-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255, 216, 77, 0.34);
}

.festival-item:first-child {
  border-top: 0;
}

.festival-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.festival-icon {
  margin-right: 12rpx;
  font-size: 34rpx;
}

.festival-name {
  color: #432236;
  font-size: 28rpx;
  font-weight: 600;
}

.festival-days {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 700;
  background: #ffe37a;
}
