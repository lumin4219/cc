<view class="page">
  <view class="hero">
    <view>
      <view class="hero-badge">📅 礼物日历</view>
      <view class="app-name">{{title}}</view>
      <view class="app-slogan">记住重要日子，提前准备心意</view>
      <view class="hero-tags">
        <text>红点=节日</text>
        <text>紫点=纪念日</text>
      </view>
    </view>
    <navigator class="about-entry" url="/pages/about/about">关于</navigator>
    <view class="hero-glow"></view>
  </view>

  <view class="calendar-card">
    <view class="calendar-header">
      <button class="month-button" data-offset="-1" bindtap="changeMonth">‹</button>
      <view>
        <view class="calendar-title">{{monthTitle}}</view>
        <view class="calendar-subtitle">点日期开始为 TA 选礼物</view>
      </view>
      <button class="month-button" data-offset="1" bindtap="changeMonth">›</button>
    </view>

    <view class="week-row">
      <view class="week-cell" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="month-grid">
      <view
        class="day-cell {{item.empty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}}"
        wx:for="{{monthDays}}"
        wx:key="key"
        data-index="{{index}}"
        bindtap="handleDayTap"
      >
        <text wx:if="{{!item.empty}}">{{item.day}}</text>
        <view class="dot-row" wx:if="{{!item.empty}}">
          <view class="dot red" wx:if="{{item.hasFestival}}"></view>
          <view class="dot purple" wx:if="{{item.hasAnniversary}}"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="scene-picker-card" wx:if="{{showScenePanel}}">
    <view class="scene-picker-header">
      <view>
        <view class="scene-picker-title">{{selectedDateTitle}}</view>
        <view class="scene-picker-desc">先选这一天的场景，再选择收礼人</view>
      </view>
      <button class="scene-close-button" bindtap="closeScenePanel">×</button>
    </view>

    <view class="scene-option-list">
      <view
        class="scene-option"
        wx:for="{{sceneOptions}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="handleSceneChoiceTap"
      >
        <view class="scene-option-icon">{{item.icon}}</view>
        <view class="scene-option-main">
          <view class="scene-option-name">{{item.name}}</view>
          <view class="scene-option-label">{{item.label}} · {{item.scene}}</view>
        </view>
        <view class="scene-option-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="add-card">
    <view class="add-summary">
      <view>
        <view class="add-title">我的纪念日</view>
        <view class="add-desc">已保存 {{anniversaryCount}} 个纪念日</view>
      </view>
      <button class="add-button" bindtap="toggleAddPanel">{{showAddPanel ? '收起' : '添加'}}</button>
    </view>
    <view class="add-form" wx:if="{{showAddPanel}}">
      <input class="form-input" placeholder="例如：我们的纪念日 / 妈妈生日" value="{{newAnniversaryName}}" bindinput="handleNameInput" />
      <picker mode="date" value="{{newAnniversaryDate}}" bindchange="handleDateChange">
        <view class="date-picker">日期：{{newAnniversaryDate || '请选择'}}</view>
      </picker>
      <button class="save-button" bindtap="saveAnniversary">保存纪念日</button>
    </view>
  </view>

  <view class="festival-card">
    <view class="festival-title">⏰ 即将到来</view>
    <view class="festival-list">
      <view class="festival-item" wx:for="{{upcomingEvents}}" wx:key="id" data-index="{{index}}" bindtap="handleUpcomingTap">
        <view class="festival-main">
          <text class="festival-icon">{{item.icon}}</text>
          <text class="festival-name">{{item.name}}</text>
        </view>
        <view class="festival-days">
          <text wx:if="{{item.daysLeft === 0}}">就是今天</text>
          <text wx:else>还有 {{item.daysLeft}} 天</text>
        </view>
      </view>
    </view>
  </view>
</view>
