.about-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff1ea, #ffffff);
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  font-size: 52rpx;
  background: #fff8f0;
}

.intro-card {
  margin-top: 28rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  box-shadow: 0 14rpx 32rpx rgba(255, 107, 107, 0.2);
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
}

.intro-text {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.7;
}

.section-card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2f2f;
}

.section-text {
  margin-top: 14rpx;
  color: #8b6b63;
  font-size: 26rpx;
  line-height: 1.7;
}

.step-list {
  margin-top: 22rpx;
}

.step-item {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.step-item:first-child {
  margin-top: 0;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-title {
  color: #3d2f2f;
  font-size: 28rpx;
  font-weight: 700;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #8b6b63;
  font-size: 26rpx;
  line-height: 1.7;
}

.bullet-dot {
  color: #ff6b6b;
  font-weight: 700;
}

.share-button,
.home-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.share-button::after {
  border: 0;
}

.share-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 107, 0.22);
}

.home-link {
  color: #ff6b6b;
  background: #fff1ea;
}
