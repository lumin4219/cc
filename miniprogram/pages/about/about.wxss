.about-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 38rpx 34rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.44);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff6fb 0%, #ffffff 54%, #fff2a8 150%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.14);
}

.hero-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  font-size: 52rpx;
  background: linear-gradient(135deg, #fff2a8, #ffe37a);
  box-shadow: 0 10rpx 22rpx rgba(255, 216, 77, 0.28);
}

.intro-card {
  margin-top: 28rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.42);
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2 0%, #ff8ac0 58%, #ffd84d 135%);
  box-shadow: 0 22rpx 48rpx rgba(255, 95, 162, 0.24);
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
}

.intro-text {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.92);
  font-size: 26rpx;
  line-height: 1.7;
}

.section-card {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #321d2c;
}

.section-text {
  margin-top: 14rpx;
  color: #8f5d73;
  font-size: 26rpx;
  line-height: 1.7;
}

.step-list {
  margin-top: 22rpx;
}

.step-item {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.step-item:first-child {
  margin-top: 0;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
}

.step-content {
  flex: 1;
  min-width: 0;
}

.step-title {
  color: #321d2c;
  font-size: 28rpx;
  font-weight: 700;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #8f5d73;
  font-size: 26rpx;
  line-height: 1.7;
}

.bullet-dot {
  color: #ff4f99;
  font-weight: 700;
}

.share-button,
.home-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 28rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.share-button::after {
  border: 0;
}

.share-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
  box-shadow: 0 14rpx 30rpx rgba(255, 95, 162, 0.28);
}

.home-link {
  color: #ff4f99;
  background: #fff0b8;
}
