.result-hero {
  padding: 34rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff1ea, #ffffff);
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.hero-label {
  margin-bottom: 12rpx;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 700;
}

.selected-card {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.08);
}

.selected-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ff6b6b;
  font-size: 25rpx;
  font-weight: 600;
  background: #fff1ea;
}

.favorite-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.favorite-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.favorite-title {
  color: #3d2f2f;
  font-size: 30rpx;
  font-weight: 700;
}

.favorite-desc {
  margin-top: 8rpx;
  color: #8b6b63;
  font-size: 24rpx;
  line-height: 1.6;
}

.favorite-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b68a7e;
  font-size: 22rpx;
  background: #fff8f0;
}

.favorite-status.saved {
  color: #8a6400;
  background: rgba(255, 215, 0, 0.24);
}

.date-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid #fff1ea;
  border-radius: 16rpx;
  background: #fffaf6;
}

.date-label {
  color: #b68a7e;
  font-size: 23rpx;
}

.date-value {
  margin-top: 8rpx;
  color: #3d2f2f;
  font-size: 30rpx;
  font-weight: 700;
}

.date-arrow {
  flex-shrink: 0;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 600;
}

.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  color: #6f5550;
  font-size: 24rpx;
  background: #fffdf7;
}

.favorite-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.favorite-save-button,
.favorite-remove-button {
  min-height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.favorite-save-button::after,
.favorite-remove-button::after {
  border: 0;
}

.favorite-save-button {
  flex: 1;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
}

.favorite-remove-button {
  flex: 0 0 180rpx;
  color: #ff6b6b;
  background: #fff1ea;
}

.favorite-note {
  margin-top: 16rpx;
  color: #b68a7e;
  font-size: 22rpx;
  line-height: 1.6;
}

.match-note {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #ffd700;
  border-radius: 12rpx;
  color: #8b6b63;
  font-size: 25rpx;
  line-height: 1.6;
  background: #fffdf7;
}

.gift-list {
  margin-top: 28rpx;
}

.gift-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.12);
}

.gift-card:first-child {
  margin-top: 0;
}

.gift-card:active {
  transform: scale(0.99);
}

.gift-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.gift-main {
  flex: 1;
  min-width: 0;
}

.gift-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gift-name {
  color: #3d2f2f;
  font-size: 32rpx;
  font-weight: 700;
}

.match-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a6400;
  font-size: 21rpx;
  background: rgba(255, 215, 0, 0.22);
}

.gift-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
  color: #9a7770;
  font-size: 24rpx;
}

.dot {
  margin: 0 10rpx;
}

.expand-icon {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 600;
}

.rating-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.stars {
  color: #ffd700;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.score-text {
  color: #b68a7e;
  font-size: 23rpx;
}

.reason {
  margin-top: 18rpx;
  color: #5a4541;
  font-size: 27rpx;
  line-height: 1.7;
}

.gift-detail {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f5e5dd;
}

.detail-row {
  margin-top: 18rpx;
}

.detail-row:first-child {
  margin-top: 0;
}

.detail-label {
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-text {
  margin-top: 8rpx;
  color: #6f5550;
  font-size: 25rpx;
  line-height: 1.7;
}

.empty-card {
  margin-top: 28rpx;
  padding: 42rpx 28rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.empty-icon {
  font-size: 60rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #3d2f2f;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 14rpx;
  color: #8b6b63;
  font-size: 26rpx;
  line-height: 1.6;
}

.flower-section {
  margin-top: 36rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 215, 0, 0.34);
  border-radius: 16rpx;
  background: linear-gradient(180deg, #fffdf7, #ffffff);
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 107, 0.1);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #3d2f2f;
  font-size: 31rpx;
  font-weight: 700;
}

.flower-summary {
  margin-top: 14rpx;
  color: #8b6b63;
  font-size: 25rpx;
  line-height: 1.7;
}

.flower-list {
  margin-top: 22rpx;
}

.flower-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fffaf6;
}

.flower-card:first-child {
  margin-top: 0;
}

.flower-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.flower-name {
  color: #3d2f2f;
  font-size: 29rpx;
  font-weight: 700;
}

.flower-color {
  margin-top: 6rpx;
  color: #b68a7e;
  font-size: 23rpx;
}

.recipient-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ff6b6b;
  font-size: 21rpx;
  background: #fff1ea;
}

.flower-language,
.flower-tip,
.flower-taboo {
  margin-top: 14rpx;
  color: #6f5550;
  font-size: 24rpx;
  line-height: 1.7;
}

.flower-language {
  color: #4a3734;
  font-weight: 600;
}

.action-bar {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.share-button,
.restart-button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.share-button::after,
.restart-button::after {
  border: 0;
}

.share-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 107, 0.22);
}

.restart-button {
  color: #ff6b6b;
  background: #fff1ea;
}
