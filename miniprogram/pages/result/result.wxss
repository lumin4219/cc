.result-hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 34rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.45);
  border-radius: 38rpx;
  background: linear-gradient(135deg, #ff5fa2 0%, #ff8ac0 62%, #ffd84d 145%);
  box-shadow: 0 24rpx 52rpx rgba(255, 95, 162, 0.26);
}

.result-hero::after {
  position: absolute;
  right: -60rpx;
  bottom: -72rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  content: "";
}

.hero-label {
  display: inline-flex;
  margin-bottom: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffe37a;
}

.result-hero .page-title,
.result-hero .page-subtitle {
  color: #ffffff;
}

.result-hero .page-title {
  text-shadow: 0 4rpx 14rpx rgba(151, 36, 95, 0.22);
}

.result-hero .page-subtitle {
  color: rgba(255, 255, 255, 0.92);
}

.selected-card {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.38);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(255, 95, 162, 0.1);
}

.selected-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ff4f99;
  font-size: 25rpx;
  font-weight: 800;
  background: #fff0b8;
}

.favorite-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.36);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 38rpx rgba(255, 95, 162, 0.11);
}

.favorite-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.favorite-title {
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 700;
}

.favorite-desc {
  margin-top: 8rpx;
  color: #8f5d73;
  font-size: 24rpx;
  line-height: 1.6;
}

.favorite-status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #a05b76;
  font-size: 22rpx;
  background: #fff0b8;
}

.favorite-status.saved {
  color: #8a4a00;
  font-weight: 800;
  background: #ffe37a;
}

.date-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.44);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaff, #fff8df);
}

.date-label {
  color: #a05b76;
  font-size: 23rpx;
}

.date-value {
  margin-top: 8rpx;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 700;
}

.date-arrow {
  flex-shrink: 0;
  color: #ff4f99;
  font-size: 24rpx;
  font-weight: 600;
}

.reminder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  color: #7b4b61;
  font-size: 24rpx;
  background: #fff8df;
}

.favorite-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.favorite-save-button,
.favorite-remove-button {
  min-height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.favorite-save-button::after,
.favorite-remove-button::after {
  border: 0;
}

.favorite-save-button {
  flex: 1;
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
}

.favorite-remove-button {
  flex: 0 0 180rpx;
  color: #ff4f99;
  background: #fff0b8;
}

.favorite-note {
  margin-top: 16rpx;
  color: #a05b76;
  font-size: 22rpx;
  line-height: 1.6;
}

.match-note {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-left: 8rpx solid #ffd84d;
  border-radius: 20rpx;
  color: #8f5d73;
  font-size: 25rpx;
  line-height: 1.6;
  background: #fff8df;
}

.gift-list {
  margin-top: 28rpx;
}

.gift-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.36);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.13);
}

.gift-card:first-child {
  margin-top: 0;
}

.gift-card:active {
  transform: scale(0.99);
}

.gift-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.gift-main {
  flex: 1;
  min-width: 0;
}

.gift-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.gift-name {
  color: #321d2c;
  font-size: 32rpx;
  font-weight: 700;
}

.match-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #8a4a00;
  font-size: 21rpx;
  font-weight: 800;
  background: #ffe37a;
}

.gift-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
  color: #a05b76;
  font-size: 24rpx;
}

.dot {
  margin: 0 10rpx;
}

.expand-icon {
  flex-shrink: 0;
  margin-left: 18rpx;
  color: #ff4f99;
  font-size: 24rpx;
  font-weight: 600;
}

.rating-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.stars {
  color: #ffd84d;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.score-text {
  color: #a05b76;
  font-size: 23rpx;
}

.reason {
  margin-top: 18rpx;
  color: #5f354d;
  font-size: 27rpx;
  line-height: 1.7;
}

.gift-detail {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 216, 77, 0.36);
}

.detail-row {
  margin-top: 18rpx;
}

.detail-row:first-child {
  margin-top: 0;
}

.detail-label {
  color: #ff4f99;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-text {
  margin-top: 8rpx;
  color: #7b4b61;
  font-size: 25rpx;
  line-height: 1.7;
}

.empty-card {
  margin-top: 28rpx;
  padding: 42rpx 28rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.36);
  border-radius: 30rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 38rpx rgba(255, 95, 162, 0.11);
}

.empty-icon {
  font-size: 60rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #321d2c;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-text {
  margin-top: 14rpx;
  color: #8f5d73;
  font-size: 26rpx;
  line-height: 1.6;
}

.flower-section {
  margin-top: 36rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.5);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fffbe6, #ffffff 72%);
  box-shadow: 0 18rpx 42rpx rgba(255, 95, 162, 0.12);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #321d2c;
  font-size: 31rpx;
  font-weight: 900;
}

.flower-summary {
  margin-top: 14rpx;
  color: #8f5d73;
  font-size: 25rpx;
  line-height: 1.7;
}

.flower-list {
  margin-top: 22rpx;
}

.flower-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.flower-row {
  display: flex;
}

.flower-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(255, 216, 77, 0.34);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fffaff, #fff8df);
}

.flower-card.horizontal {
  display: inline-flex;
  flex-direction: column;
  width: 520rpx;
  min-height: 260rpx;
  margin-top: 0;
  margin-right: 20rpx;
  white-space: normal;
}

.flower-card:first-child {
  margin-top: 0;
}

.flower-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.flower-name {
  color: #321d2c;
  font-size: 29rpx;
  font-weight: 900;
}

.flower-color {
  margin-top: 6rpx;
  color: #a05b76;
  font-size: 23rpx;
}

.recipient-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #ff4f99;
  font-size: 21rpx;
  font-weight: 800;
  background: #fff0b8;
}

.flower-language,
.flower-tip,
.flower-taboo {
  margin-top: 14rpx;
  color: #7b4b61;
  font-size: 24rpx;
  line-height: 1.7;
}

.flower-language {
  color: #432236;
  font-weight: 800;
}

.action-bar {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.share-button,
.restart-button {
  flex: 1;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.share-button::after,
.restart-button::after {
  border: 0;
}

.share-button {
  color: #ffffff;
  background: linear-gradient(135deg, #ff5fa2, #ff8ac0);
  box-shadow: 0 14rpx 30rpx rgba(255, 95, 162, 0.28);
}

.restart-button {
  color: #ff4f99;
  background: #fff0b8;
}
